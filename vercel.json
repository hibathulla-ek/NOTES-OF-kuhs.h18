{
  "rewrites": [
    {
      "source": "/api/admin/note",
      "destination": "/api/admin/notes"
    },
    {
      "source": "/api/admin/question",
      "destination": "/api/admin/questions"
    },
    {
      "source": "/api/admin/mcq",
      "destination": "/api/admin/mcqs"
    },
    {
      "source": "/api/admin/request",
      "destination": "/api/admin/requests"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
